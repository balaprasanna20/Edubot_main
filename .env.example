# -----------------------------------------------------------------------------
# Edubot Environment Variables Configuration (.env.example)
# Copy this file to .env.local for local development.
# -----------------------------------------------------------------------------

# Resend API Key for server-side demo enquiry delivery
# Obtain from your Resend dashboard: https://resend.com/api-keys
# Format: re_123456789...
RESEND_API_KEY=

# Recipient Email Address where demo enquiries should be sent
# Default: info@codework.ai
DEMO_SUBMISSION_RECIPIENT_EMAIL=info@codework.ai

# Verified Sender Email Address (must match a verified domain in Resend)
# In development/testing, you can use: onboarding@resend.dev
# In production, use: Edubot Demo <demo@codework.ai> (or your verified domain)
DEMO_SUBMISSION_SENDER_EMAIL="Edubot Demo <onboarding@resend.dev>"

# Allowed Origins for CSRF & cross-origin request validation (comma-separated)
# Leave blank to automatically allow same-origin requests matching Host header.
ALLOWED_ORIGINS=http://localhost:3000,https://edubot.codework.ai

